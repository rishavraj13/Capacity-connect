# Development only. Replace SECRET_KEY. Never commit .env.
ADMIN_URL=django-admin/
ALLOWED_HOSTS=localhost,127.0.0.1
CACHE_TABLE=capacity_connect_cache
CACHE_URL=dbcache://capacity_connect_cache
CERTIFICATE_MAX_BYTES=5242880
CERTIFICATE_SIGNATORY_NAME="Capacity Connect Administrator"
CERTIFICATE_SIGNATORY_TITLE="Programme Director"
CONTENT_SECURITY_POLICY="default-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=True
DATABASE_URL=sqlite:///db.sqlite3
DEBUG=True
DEMO_PASSWORD=Demo-Connect-2026!
LIBRARY_DOCUMENT_MAX_BYTES=26214400
LIBRARY_PRESENTATION_MAX_BYTES=26214400
LIBRARY_VIDEO_MAX_BYTES=209715200
LOGIN_FAILURE_LIMIT=5
LOGIN_IP_LIMIT=20
LOGIN_WINDOW_SECONDS=900
PHOTO_MAX_BYTES=2097152
PRIVATE_MEDIA_ROOT=private_uploads
SECRET_KEY=replace-with-a-long-random-development-key-before-use
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_HSTS_SECONDS=3600
SECURE_REFERRER_POLICY=same-origin
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_AGE=43200
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
SIGNUP_IP_LIMIT=5
SIGNUP_WINDOW_SECONDS=3600
SITE_BASE_URL=http://127.0.0.1:8000
TRUSTED_PROXY_COUNT=0
USE_X_FORWARDED_PROTO=False
VERIFY_IP_LIMIT=30
VERIFY_WINDOW_SECONDS=60
X_FRAME_OPTIONS=DENY
